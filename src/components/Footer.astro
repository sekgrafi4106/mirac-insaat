---
import { company } from "../data/company";
import BrandLogo from "./BrandLogo.astro";
import { withBase } from "../lib/paths";

const year = new Date().getFullYear();

const navItems = [
  { href: "/", label: "Ana Sayfa" },
  { href: "/projeler", label: "Projeler" },
  { href: "/hakkimizda", label: "Hakkımızda" },
  { href: "/hizmetler", label: "Hizmetler" },
  { href: "/iletisim", label: "İletişim" },
];
---

<footer class="border-t border-off-white/10 bg-dark text-off-white">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <BrandLogo theme="off-white" />
        <p class="mt-4 font-body text-sm text-off-white/70">
          {company.regions.join(" · ")} · {company.foundedYear}'ten beri
        </p>
      </div>

      <nav aria-label="Alt menü">
        <ul class="flex flex-col gap-2">
          {navItems.map((item) => (
            <li>
              <a href={withBase(item.href)} class="font-body text-sm text-off-white/80 transition-colors hover:text-bronze-light">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="flex flex-col gap-2 font-body text-sm text-off-white/80">
        <a href={company.phoneHref} class="transition-colors hover:text-bronze-light">{company.phone}</a>
        <a href={company.whatsappHref} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-bronze-light">
          WhatsApp ile iletişime geçin
        </a>
      </div>
    </div>

    <p class="mt-10 border-t border-off-white/10 pt-6 font-body text-xs text-off-white/50">
      © {year} {company.legalName}. Tüm hakları saklıdır.
    </p>
  </div>
</footer>
