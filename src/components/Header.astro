---
import { company } from "../data/company";

const navItems = [
  { href: "/", label: "Ana Sayfa" },
  { href: "/projeler", label: "Projeler" },
  { href: "/hakkimizda", label: "Hakkımızda" },
  { href: "/hizmetler", label: "Hizmetler" },
  { href: "/iletisim", label: "İletişim" },
];
---

<header class="sticky top-0 z-50 border-b border-charcoal/10 bg-off-white/95 backdrop-blur-sm">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="font-heading text-lg font-extrabold tracking-tight text-charcoal">
      {company.name}
    </a>

    <nav class="hidden md:block" aria-label="Ana menü">
      <ul class="flex items-center gap-8">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="font-body text-sm font-medium text-charcoal transition-colors hover:text-bronze"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-4">
      <a
        href={company.whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden rounded-sm bg-bronze px-4 py-2 font-body text-sm font-medium text-off-white transition-colors hover:bg-bronze-light sm:inline-block"
      >
        WhatsApp
      </a>

      <button
        id="menu-toggle"
        type="button"
        class="inline-flex items-center justify-center p-2 text-charcoal md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Menüyü aç"
      >
        <svg id="icon-open" class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="hidden h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-charcoal/10 md:hidden" aria-label="Mobil menü">
    <ul class="flex flex-col gap-1 px-6 py-4">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class="block py-2 font-body text-base font-medium text-charcoal transition-colors hover:text-bronze"
          >
            {item.label}
          </a>
        </li>
      ))}
      <li class="pt-2">
        <a
          href={company.whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block rounded-sm bg-bronze px-4 py-2 font-body text-sm font-medium text-off-white transition-colors hover:bg-bronze-light"
        >
          WhatsApp
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  toggle?.addEventListener("click", () => {
    const isExpanded = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!isExpanded));
    toggle.setAttribute("aria-label", isExpanded ? "Menüyü aç" : "Menüyü kapat");
    menu?.classList.toggle("hidden");
    iconOpen?.classList.toggle("hidden");
    iconClose?.classList.toggle("hidden");
  });
</script>
