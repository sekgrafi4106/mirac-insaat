---
import { company } from "../data/company";
import BrandLogo from "./BrandLogo.astro";
import { withBase } from "../lib/paths";

const navItems = [
  { href: "/", label: "Ana Sayfa" },
  { href: "/projeler", label: "Projeler" },
  { href: "/hakkimizda", label: "Hakkımızda" },
  { href: "/hizmetler", label: "Hizmetler" },
  { href: "/iletisim", label: "İletişim" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  const target = withBase(href);
  return href === "/" ? currentPath === target : currentPath.startsWith(target);
};

const navLinkClass = (href: string) =>
  `inline-block border-b-2 pb-1 font-body text-xs font-medium uppercase tracking-widest transition-colors ${
    isActive(href)
      ? "border-bronze text-bronze"
      : "border-transparent text-charcoal hover:border-bronze/40 hover:text-bronze"
  }`;
---

<header class="sticky top-0 z-50 border-b border-charcoal/10 bg-off-white/95 backdrop-blur-sm">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3.5 lg:px-8">
    <BrandLogo />

    <nav class="hidden md:block" aria-label="Ana menü">
      <ul class="flex items-center gap-10">
        {navItems.map((item) => (
          <li>
            <a href={withBase(item.href)} aria-current={isActive(item.href) ? "page" : undefined} class={navLinkClass(item.href)}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-4">
      <a
        href={company.whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden border border-bronze px-5 py-2 font-body text-xs font-semibold uppercase tracking-widest text-bronze transition-colors hover:bg-bronze hover:text-off-white sm:inline-block"
      >
        WhatsApp
      </a>

      <button
        id="menu-toggle"
        type="button"
        class="inline-flex items-center justify-center p-1.5 text-charcoal md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Menüyü aç"
      >
        <svg id="icon-open" class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="hidden h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-charcoal/10 md:hidden" aria-label="Mobil menü">
    <ul class="flex flex-col gap-1 px-6 py-4">
      {navItems.map((item) => (
        <li>
          <a
            href={withBase(item.href)}
            aria-current={isActive(item.href) ? "page" : undefined}
            class={`block py-2 font-body text-sm font-medium uppercase tracking-widest transition-colors ${
              isActive(item.href) ? "text-bronze" : "text-charcoal hover:text-bronze"
            }`}
          >
            {item.label}
          </a>
        </li>
      ))}
      <li class="pt-2">
        <a
          href={company.whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block border border-bronze px-5 py-2 font-body text-xs font-semibold uppercase tracking-widest text-bronze transition-colors hover:bg-bronze hover:text-off-white"
        >
          WhatsApp
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  toggle?.addEventListener("click", () => {
    const isExpanded = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!isExpanded));
    toggle.setAttribute("aria-label", isExpanded ? "Menüyü aç" : "Menüyü kapat");
    menu?.classList.toggle("hidden");
    iconOpen?.classList.toggle("hidden");
    iconClose?.classList.toggle("hidden");
  });
</script>
