---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="border-b border-charcoal/10 bg-off-white">
  <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
    {eyebrow && (
      <p class="font-body text-sm font-medium uppercase tracking-widest text-bronze">
        {eyebrow}
      </p>
    )}
    <h1 class="mt-3 max-w-3xl font-heading text-4xl font-bold text-charcoal md:text-5xl">
      {title}
    </h1>
    {description && (
      <p class="mt-6 max-w-2xl font-body text-lg leading-relaxed text-charcoal/70">
        {description}
      </p>
    )}
  </div>
</section>
