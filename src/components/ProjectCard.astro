---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;

const statusLabels: Record<NonNullable<Project["status"]>, string> = {
  "tamamlandi": "Tamamlandı",
  "devam-ediyor": "Devam Ediyor",
  "planlanan": "Planlanan",
};

const meta = [project.location, project.completionDate].filter(Boolean).join(" · ");
---

<a href={`/projeler/${project.slug}`} class="group block" data-status={project.status ?? ""}>
  <div class="relative aspect-[4/3] overflow-hidden bg-charcoal">
    {project.coverImage ? (
      <img
        src={project.coverImage}
        alt={project.title}
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
      />
    ) : (
      <div class="flex h-full w-full items-center justify-center px-6 text-center">
        <span class="font-heading text-base font-medium tracking-wide text-off-white/40">
          {project.title}
        </span>
      </div>
    )}
    {project.status && (
      <span class="absolute left-4 top-4 bg-off-white/95 px-3 py-1 font-body text-xs font-medium uppercase tracking-wide text-charcoal">
        {statusLabels[project.status]}
      </span>
    )}
  </div>

  <div class="mt-4">
    <h3 class="font-heading text-lg font-semibold text-charcoal transition-colors group-hover:text-bronze">
      {project.title}
    </h3>
    {meta && <p class="mt-1 font-body text-sm text-charcoal/60">{meta}</p>}
  </div>
</a>
