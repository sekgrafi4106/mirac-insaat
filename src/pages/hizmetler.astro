---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { company } from "../data/company";
import { services } from "../data/services";
import { withBase } from "../lib/paths";

const firstGroup = services.slice(0, 3);
const secondGroup = services.slice(3, 6);
const thirdGroup = services.slice(6);
---

<BaseLayout
  title="Hizmetler | Miraç İnşaat"
  description="Miraç İnşaat'ın İstanbul ve Kocaeli'de sunduğu hizmet alanları: konut projeleri, kat karşılığı inşaat, kentsel dönüşüm, anahtar teslim, villa projeleri, ticari yapılar ve tadilat."
>
  <PageHero
    eyebrow="Hizmetler"
    title="Farklı Yapı İhtiyaçlarına Yönelik Çalışmalar."
    description="Miraç İnşaat'ın İstanbul ve Kocaeli'de yürüttüğü proje süreçlerinde sunduğu temel hizmet alanları."
  />

  <section class="mx-auto max-w-5xl px-6 py-16 md:py-20">
    <ul class="border-t border-charcoal/10">
      {firstGroup.map((service, index) => (
        <li class="group border-b border-charcoal/10 py-10 md:py-12">
          <div class="flex flex-col gap-3 md:flex-row md:items-baseline md:gap-10">
            <span class="font-heading text-2xl font-semibold text-bronze md:w-20 md:text-3xl">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div class="flex-1">
              <h2 class="font-heading text-3xl font-bold text-charcoal md:text-5xl">{service.title}</h2>
              {service.description && (
                <p class="mt-3 max-w-2xl font-body text-base leading-relaxed text-charcoal/70 md:text-lg">
                  {service.description}
                </p>
              )}
            </div>
          </div>
        </li>
      ))}
    </ul>

    <div class="my-10 aspect-[21/9] w-full overflow-hidden bg-charcoal md:my-12">
      <img
        src={withBase("/images/projects/project-04.webp")}
        width="1500"
        height="2000"
        alt="Miraç İnşaat tarafından inşa edilen bir bina dış cephesi"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover object-[50%_70%]"
      />
    </div>

    <ul class="border-t border-charcoal/10">
      {secondGroup.map((service, index) => (
        <li class="group border-b border-charcoal/10 py-10 md:py-12">
          <div class="flex flex-col gap-3 md:flex-row md:items-baseline md:gap-10">
            <span class="font-heading text-2xl font-semibold text-bronze md:w-20 md:text-3xl">
              {String(index + 4).padStart(2, "0")}
            </span>
            <div class="flex-1">
              <h2 class="font-heading text-3xl font-bold text-charcoal md:text-5xl">{service.title}</h2>
              {service.description && (
                <p class="mt-3 max-w-2xl font-body text-base leading-relaxed text-charcoal/70 md:text-lg">
                  {service.description}
                </p>
              )}
            </div>
          </div>
        </li>
      ))}
    </ul>

    <div class="my-10 aspect-[21/9] w-full overflow-hidden bg-charcoal md:my-12">
      <img
        src={withBase("/images/projects/project-06.webp")}
        width="1500"
        height="2000"
        alt="Miraç İnşaat tarafından inşa edilen bir bina dış cephesi"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover object-[50%_62%]"
      />
    </div>

    <ul class="border-t border-charcoal/10">
      {thirdGroup.map((service, index) => (
        <li class="group border-b border-charcoal/10 py-10 md:py-12">
          <div class="flex flex-col gap-3 md:flex-row md:items-baseline md:gap-10">
            <span class="font-heading text-2xl font-semibold text-bronze md:w-20 md:text-3xl">
              {String(index + 7).padStart(2, "0")}
            </span>
            <div class="flex-1">
              <h2 class="font-heading text-3xl font-bold text-charcoal md:text-5xl">{service.title}</h2>
              {service.description && (
                <p class="mt-3 max-w-2xl font-body text-base leading-relaxed text-charcoal/70 md:text-lg">
                  {service.description}
                </p>
              )}
            </div>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <!-- FINAL CTA -->
  <section class="border-t border-charcoal/10 bg-dark text-off-white">
    <div class="mx-auto flex max-w-4xl flex-col items-center gap-8 px-6 py-20 text-center md:py-24">
      <h2 class="font-heading text-3xl font-bold leading-tight md:text-5xl">
        Projenizi Birlikte Değerlendirelim.
      </h2>
      <div class="flex w-full flex-col gap-4 sm:w-auto sm:flex-row sm:flex-wrap sm:justify-center">
        <a
          href={company.whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-bronze px-7 py-3.5 text-center font-body text-sm font-medium tracking-wide text-off-white transition-colors hover:bg-bronze-light"
        >
          WhatsApp
        </a>
        <a
          href={withBase("/iletisim")}
          class="border border-off-white/60 px-7 py-3.5 text-center font-body text-sm font-medium tracking-wide text-off-white transition-colors hover:border-off-white hover:bg-off-white/10"
        >
          İletişim
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
