---
import BaseLayout from "../layouts/BaseLayout.astro";
import { company } from "../data/company";
import { services } from "../data/services";
import { withBase } from "../lib/paths";

const portfolioImages = [
  { src: "/images/projects/project-02.webp", width: 2000, height: 1500, area: "area-a", focus: "object-center" },
  { src: "/images/projects/project-03.webp", width: 1576, height: 1981, area: "area-b", focus: "object-[50%_78%]" },
  { src: "/images/projects/project-04.webp", width: 1500, height: 2000, area: "area-c", focus: "object-[50%_70%]" },
  { src: "/images/projects/project-05.webp", width: 1500, height: 2000, area: "area-d", focus: "object-[50%_55%]" },
  { src: "/images/projects/project-06.webp", width: 1500, height: 2000, area: "area-e", focus: "object-[50%_62%]" },
];
---

<BaseLayout
  title="Miraç İnşaat | İstanbul & Kocaeli"
  description="Miraç İnşaat, 2015'ten bu yana İstanbul ve Kocaeli'de konut ve yapı projeleri gerçekleştirmektedir."
>
  <!-- 1. HERO -->
  <section class="relative flex min-h-[600px] items-end overflow-hidden sm:min-h-[640px] md:min-h-[90vh]">
    <img
      src={withBase("/images/projects/project-01.webp")}
      alt="Miraç İnşaat tarafından inşa edilen bir bina dış cephesi"
      width="2000"
      height="1141"
      class="absolute inset-0 h-full w-full object-cover"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-dark/90 via-dark/40 to-dark/10" aria-hidden="true"></div>

    <div class="relative mx-auto w-full max-w-6xl px-6 pb-16 pt-24 md:pb-24">
      <h1 class="max-w-3xl font-heading text-4xl font-bold leading-[1.08] tracking-tight text-off-white sm:text-5xl md:text-[3.25rem] lg:text-6xl">
        Güvenle Yükselen Yapılar.
      </h1>
      <p class="mt-6 max-w-lg font-body text-base leading-relaxed text-off-white/85 md:text-lg">
        2015'ten bu yana İstanbul ve Kocaeli'de yaşam alanları ve nitelikli yapılar hayata geçiriyoruz.
      </p>
      <div class="mt-9 flex flex-col gap-4 sm:flex-row sm:flex-wrap">
        <a
          href={withBase("/projeler")}
          class="bg-bronze px-7 py-3.5 text-center font-body text-sm font-medium tracking-wide text-off-white transition-colors hover:bg-bronze-light"
        >
          Projelerimizi Keşfedin
        </a>
        <a
          href={withBase("/iletisim")}
          class="border border-off-white/60 px-7 py-3.5 text-center font-body text-sm font-medium tracking-wide text-off-white transition-colors hover:border-off-white hover:bg-off-white/10"
        >
          İletişime Geçin
        </a>
      </div>
    </div>
  </section>

  <!-- 2. FACT STRIP -->
  <section class="border-b border-charcoal/10 bg-off-white">
    <div class="mx-auto grid max-w-6xl grid-cols-1 divide-y divide-charcoal/10 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
      <div class="flex flex-col items-center gap-3 px-6 py-6 md:py-7">
        <span class="h-px w-6 bg-bronze" aria-hidden="true"></span>
        <p class="font-heading text-xs font-semibold uppercase tracking-[0.15em] text-charcoal md:text-sm">
          {company.foundedYear}'TEN BERİ
        </p>
      </div>
      <div class="flex flex-col items-center gap-3 px-6 py-6 md:py-7">
        <span class="h-px w-6 bg-bronze" aria-hidden="true"></span>
        <p class="font-heading text-xs font-semibold uppercase tracking-[0.15em] text-charcoal md:text-sm">
          {company.regions.join(" & ").toLocaleUpperCase("tr")}
        </p>
      </div>
      <div class="flex flex-col items-center gap-3 px-6 py-6 md:py-7">
        <span class="h-px w-6 bg-bronze" aria-hidden="true"></span>
        <p class="font-heading text-xs font-semibold uppercase tracking-[0.15em] text-charcoal md:text-sm">
          {services.length} HİZMET ALANI
        </p>
      </div>
    </div>
  </section>

  <!-- 3. SELECTED WORKS -->
  <section class="mx-auto max-w-6xl px-6 py-16 md:py-20">
    <p class="font-body text-xs font-semibold uppercase tracking-[0.2em] text-bronze">Portföy</p>
    <h2 class="mt-3 font-heading text-3xl font-bold text-charcoal md:text-4xl">Seçili Çalışmalar</h2>

    <div class="portfolio-grid mt-10">
      {portfolioImages.map((image, index) => (
        <div class={`hover-zoom overflow-hidden bg-charcoal ${image.area}`}>
          <img
            src={withBase(image.src)}
            width={image.width}
            height={image.height}
            alt={`Miraç İnşaat tarafından inşa edilen bir bina dış cephesi ${index + 1}`}
            loading="lazy"
            decoding="async"
            class={`h-full w-full object-cover ${image.focus}`}
          />
        </div>
      ))}
    </div>
  </section>

  <!-- 4. BRAND STATEMENT -->
  <section class="bg-charcoal text-off-white">
    <div class="mx-auto max-w-6xl px-6 py-20 md:py-24">
      <div class="md:grid md:grid-cols-12 md:items-end md:gap-8">
        <h2 class="font-heading text-3xl font-bold leading-[1.15] md:col-span-7 md:text-5xl">
          2015'ten bu yana İstanbul ve Kocaeli'de.
        </h2>
        <div class="mt-8 md:col-span-5 md:mt-0">
          <p class="font-body text-lg leading-relaxed text-off-white/75">
            Miraç İnşaat; konut, kentsel dönüşüm, kat karşılığı, anahtar teslim ve farklı yapı projelerinde
            çalışmalarını sürdürmektedir.
          </p>
          <a
            href={withBase("/projeler")}
            class="mt-8 inline-block bg-bronze px-7 py-3.5 font-body text-sm font-medium tracking-wide text-off-white transition-colors hover:bg-bronze-light"
          >
            Projelerimizi İnceleyin
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. SERVICES PREVIEW -->
  <section class="mx-auto max-w-6xl px-6 pt-16 pb-10 md:pt-20 md:pb-12">
    <h2 class="font-heading text-3xl font-bold text-charcoal md:text-4xl">Hizmetlerimiz</h2>

    <ul class="mt-8 divide-y divide-charcoal/10 border-t border-charcoal/10 md:grid md:grid-cols-2 md:divide-y-0 md:gap-x-12">
      {services.map((service, index) => (
        <li class="group flex items-baseline gap-6 border-charcoal/10 py-5 md:border-b">
          <span class="font-heading text-sm font-semibold text-bronze/70 transition-colors group-hover:text-bronze">
            {String(index + 1).padStart(2, "0")}
          </span>
          <h3 class="font-heading text-xl font-semibold text-charcoal transition-colors group-hover:text-bronze md:text-2xl">
            {service.title}
          </h3>
        </li>
      ))}
    </ul>

    <a
      href={withBase("/hizmetler")}
      class="mt-8 inline-block border border-charcoal px-7 py-3.5 font-body text-sm font-medium tracking-wide text-charcoal transition-colors hover:border-bronze hover:text-bronze"
    >
      Tüm Hizmetleri İnceleyin
    </a>
  </section>

  <!-- 6. ABOUT PREVIEW -->
  <section class="border-t border-charcoal/10 bg-off-white">
    <div class="mx-auto grid max-w-6xl gap-10 px-6 py-16 md:grid-cols-[55fr_45fr] md:items-stretch md:gap-14 md:py-20">
      <div class="aspect-[4/3] overflow-hidden bg-charcoal md:aspect-auto md:min-h-[420px]">
        <img
          src={withBase("/images/projects/project-03.webp")}
          width="1576"
          height="1981"
          alt="Miraç İnşaat tarafından inşa edilen bir bina dış cephesi"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover object-[50%_78%]"
        />
      </div>

      <div class="flex flex-col justify-center">
        <p class="font-body text-xs font-semibold uppercase tracking-[0.2em] text-bronze">
          {company.legalName} / {company.foundedYear}
        </p>
        <h2 class="mt-3 font-heading text-3xl font-bold text-charcoal md:text-4xl">Hakkımızda</h2>
        <p class="mt-6 font-body text-lg leading-relaxed text-charcoal/80">
          {company.legalName}, {company.owner} liderliğinde {company.foundedYear} yılında kurulmuş bir inşaat
          şirketidir. {company.regions.join(" ve ")} bölgelerinde konut ve yapı hizmetleri alanında çalışmalar
          yürütmektedir.
        </p>
        <p class="mt-3 font-body text-sm text-charcoal/50">{company.regions.join(" & ")}</p>
        <p class="mt-2 font-body text-xs uppercase tracking-wide text-charcoal/40">
          Konut · Kentsel Dönüşüm · Anahtar Teslim · Ticari Yapılar
        </p>
        <a
          href={withBase("/hakkimizda")}
          class="mt-8 inline-block font-body text-sm font-medium text-bronze transition-colors hover:text-bronze-light"
        >
          Hakkımızda →
        </a>
      </div>
    </div>
  </section>

  <!-- 7. FINAL CTA -->
  <section class="bg-dark text-off-white">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center md:py-24">
      <span class="mx-auto block h-px w-16 bg-bronze" aria-hidden="true"></span>
      <h2 class="mt-8 font-heading text-3xl font-bold leading-tight md:text-5xl">
        Yeni Projenizi Birlikte Değerlendirelim.
      </h2>
      <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:justify-center">
        <a
          href={company.whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-bronze px-7 py-3.5 text-center font-body text-sm font-medium tracking-wide text-off-white transition-colors hover:bg-bronze-light"
        >
          WhatsApp ile Ulaşın
        </a>
        <a
          href={company.phoneHref}
          class="border border-off-white/60 px-7 py-3.5 text-center font-body text-sm font-medium tracking-wide text-off-white transition-colors hover:border-off-white hover:bg-off-white/10"
        >
          {company.phone}
        </a>
      </div>
      <a
        href={company.instagramHref}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-block font-body text-sm text-off-white/50 transition-colors hover:text-bronze-light"
      >
        {company.instagramHandle}
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .portfolio-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .area-a,
  .area-c,
  .area-d,
  .area-e {
    aspect-ratio: 4 / 3;
  }

  .area-b {
    aspect-ratio: 3 / 4;
  }

  @media (min-width: 640px) {
    .portfolio-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .area-a {
      grid-column: 1 / 3;
      aspect-ratio: 16 / 9;
    }
  }

  @media (min-width: 1024px) {
    .portfolio-grid {
      grid-template-columns: repeat(12, 1fr);
      grid-template-rows: repeat(2, 1fr);
      aspect-ratio: 2.3 / 1;
    }

    .portfolio-grid > div {
      aspect-ratio: auto;
    }

    .area-a {
      grid-column: 1 / 7;
      grid-row: 1 / 3;
    }

    .area-b {
      grid-column: 7 / 9;
      grid-row: 1 / 3;
    }

    .area-c {
      grid-column: 9 / 13;
      grid-row: 1 / 2;
    }

    .area-d {
      grid-column: 9 / 11;
      grid-row: 2 / 3;
    }

    .area-e {
      grid-column: 11 / 13;
      grid-row: 2 / 3;
    }
  }
</style>
