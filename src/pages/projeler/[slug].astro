---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../data/projects";

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

const statusLabels: Record<string, string> = {
  "tamamlandi": "Tamamlandı",
  "devam-ediyor": "Devam Ediyor",
  "planlanan": "Planlanan",
};

const meta = [
  project.location,
  project.completionDate,
  project.status ? statusLabels[project.status] : null,
]
  .filter(Boolean)
  .join(" · ");
---

<BaseLayout title={`${project.title} | Miraç İnşaat`} description={project.description ?? undefined}>
  <article class="mx-auto max-w-4xl px-6 py-20 md:py-28">
    {project.coverImage && (
      <div class="mb-10 aspect-[16/9] overflow-hidden bg-charcoal">
        <img src={project.coverImage} alt={project.title} class="h-full w-full object-cover" />
      </div>
    )}

    <h1 class="font-heading text-3xl font-bold text-charcoal md:text-5xl">{project.title}</h1>
    {meta && <p class="mt-3 font-body text-base text-charcoal/60">{meta}</p>}
    {project.description && (
      <p class="mt-8 max-w-2xl font-body text-lg leading-relaxed text-charcoal/80">
        {project.description}
      </p>
    )}

    <a
      href="/projeler"
      class="mt-12 inline-block font-body text-sm font-medium text-bronze transition-colors hover:text-bronze-light"
    >
      ← Tüm projelere dön
    </a>
  </article>
</BaseLayout>
